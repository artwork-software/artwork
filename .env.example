APP_NAME=Artwork
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Reverse-Proxies, deren X-Forwarded-*-Header vertraut wird (kommagetrennt, IPs/CIDRs).
# Leer = Default aus config/app.php: Loopback + private Netze (Docker-Stack, Intranet).
# Sitzt der Proxy auf einer oeffentlichen IP, hier eintragen. '*' nur, wenn der Container
# ausschliesslich ueber den Proxy erreichbar ist (sonst sind Rate-Limits per Header umgehbar).
TRUSTED_PROXIES=

# Session-Cookie nur ueber https (Default in production: true). Nur fuer reinen
# http-Intranetbetrieb auf false setzen.
SESSION_SECURE_COOKIE=

# Zusaetzliche CORS-Origins fuer /api/* (kommagetrennt); APP_URL ist immer erlaubt.
CORS_ALLOWED_ORIGINS=

# Content-Security-Policy scharf schalten (true) statt nur Report-Only (false).
# Erst nach Beobachtung der Browser-Konsole ohne CSP-Verstoesse aktivieren.
SECURITY_CSP_ENFORCE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

TEST_DB_DATABASE=artwork_tools_test
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=artwork_tools
DB_USERNAME=sail
DB_PASSWORD=password
# Host-Adresse, an die docker-compose die Ports von DB (FORWARD_DB_PORT) und Meilisearch
# (FORWARD_MEILISEARCH_PORT) bindet. Default 127.0.0.1 = nur vom Server selbst erreichbar.
# Nur bewusst ändern (z. B. auf eine VPN-/Management-IP), nie auf 0.0.0.0 ohne Firewall.
#DB_BIND_HOST=127.0.0.1
#FORWARD_DB_PORT=3306
#FORWARD_MEILISEARCH_PORT=7700

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=ddev
SCOUT_QUEUE=true

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=somePassword
REDIS_PORT=6379

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_MAILER=smtp
MAIL_USERNAME=Inbox-Name
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
SYSTEM_MAIL=noreply@artwork.software
FALLBACK_PAGE_TITLE=Artwork

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Die PUSHER_*-Werte sind kein Pusher-Zugang mehr — sie speisen nur noch die
# REVERB_*-Variablen weiter unten. Websocket-Dienst ist Laravel Reverb.
PUSHER_APP_KEY='app-key'
PUSHER_APP_ID='app-id'
PUSHER_APP_SECRET='app-secret'
#important
PUSHER_HOST=localhost

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

SAIL_XDEBUG_MODE=debug,develop
SAIL_XDEBUG_CONFIG="client_host=host.docker.internal idekey=docker"
SAGE_API_ENABLED=false

# Backup
BACKUP_ENABLED=false
BACKUP_NOTIFICATION_TYPE=

USE_CHAT_MODULE=false

REVERB_APP_ID="${PUSHER_APP_ID}"
REVERB_APP_KEY=set-a-key-here
REVERB_APP_SECRET="${PUSHER_APP_SECRET}"
REVERB_HOST="${PUSHER_HOST}"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8080
BROADCAST_CONNECTION=reverb
