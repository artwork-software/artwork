<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="artwork-rules">
    <description>Ruleset for the artwork project</description>

    <!-- Files/Directories to check -->
    <file>app</file>
    <file>artwork</file>
    <file>tests/Unit</file>
    <file>config</file>
    <file>database</file>
    <file>routes</file>

    <!-- Excluded files/directories -->
    <exclude-pattern>./config/debugbar.php</exclude-pattern>
    <!-- Vendor-veröffentlichte Konfiguration (Tabs, lange Zeilen) — nicht unser Stil -->
    <exclude-pattern>./config/clockwork.php</exclude-pattern>
    <exclude-pattern>./database/migrations/</exclude-pattern>
    <exclude-pattern>storage/</exclude-pattern>
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>
    <exclude-pattern>**/*.js</exclude-pattern>
    <exclude-pattern>**/*.vue</exclude-pattern>

    <!-- Warnungen werden gemeldet, brechen die Pipeline aber nicht (Errors schon) -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- PSR standard -->
    <rule ref="PSR12">
        <exclude name="PSR12.Classes.OpeningBraceSpace" />
    </rule>
    <!-- Testmethoden heißen im Projekt bewusst snake_case (Feature-Tests werden gar nicht geprüft) -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>./tests/Unit/</exclude-pattern>
    </rule>

    <!-- Laravel coding style: ab 120 Zeichen Warnung, ab 160 Fehler -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120" />
            <property name="absoluteLineLimit" value="160" />
        </properties>
    </rule>

    <!-- SlevomatCodingStandard rules -->
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingNativeTypeHint" />
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingNativeTypeHint" />
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingNativeTypeHint" />
    <rule ref="SlevomatCodingStandard.Classes.PropertyDeclaration.Scope" />
    <rule ref="SlevomatCodingStandard.Classes.SuperfluousAbstractClassNaming">
        <!-- Bestandsklasse, an 20 Stellen referenziert — Umbenennung lohnt den Churn nicht -->
        <exclude-pattern>./artwork/Modules/Shift/RuleChecks/AbstractRuleCheck.php</exclude-pattern>
    </rule>

    <!-- Additional rules -->
    <rule ref="Generic.Classes.DuplicateClassName"/>
    <!-- Leere catch-Blöcke mit erklärendem Kommentar sind hier bewusstes Defensiv-Muster -->
    <rule ref="Generic.CodeAnalysis.EmptyStatement">
        <exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedCatch"/>
    </rule>
    <rule ref="Generic.CodeAnalysis.ForLoopShouldBeWhileLoop"/>
    <rule ref="Generic.CodeAnalysis.ForLoopWithTestFunctionCall"/>
    <rule ref="Generic.CodeAnalysis.JumbledIncrementer"/>
    <rule ref="Generic.CodeAnalysis.UnconditionalIfStatement"/>
    <rule ref="Generic.CodeAnalysis.UnnecessaryFinalModifier"/>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
    <rule ref="Generic.CodeAnalysis.UselessOverridingMethod"/>
    <rule ref="Generic.ControlStructures.InlineControlStructure"/>
    <rule ref="Generic.Formatting.DisallowMultipleStatements"/>
    <!-- Komplexitäts-Metriken als Hinweis, nicht als Blocker (Refactoring-Kandidaten) -->
    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <type>warning</type>
    </rule>
    <rule ref="Generic.Metrics.NestingLevel">
        <type>warning</type>
    </rule>
    <rule ref="Generic.PHP.DeprecatedFunctions"/>
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.PHP.NoSilencedErrors"/>
    <rule ref="MySource.PHP.EvalObjectFactory"/>
    <rule ref="PEAR.Classes.ClassDeclaration"/>
    <rule ref="Squiz.PHP.Eval"/>
    <!-- Rechte-Katalog: lange Übersetzungsschlüssel als Strings, keine Zeilenumbrüche im Text -->
    <exclude-pattern>artwork/Modules/Permission/Catalog/Modules/*</exclude-pattern>
</ruleset>
